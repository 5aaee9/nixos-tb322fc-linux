# Built-in support for the pinned NixOS iptables-nft firewall.
# No matching module tree is shipped by the temporary USB/NBD image.
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# iptables-nft creates separate IPv4 and IPv6 filter/mangle tables.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# Compatibility matches include TCP/UDP and ICMP/ICMPv6 in xt_tcpudp.
CONFIG_NETFILTER_XTABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y

# The generated ESTABLISHED,RELATED rule uses the xt conntrack match.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NFT_CT=y

# rpfilter --validmark uses xt matches, not the native nft fib expression.
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_MATCH_RPFILTER=y


# Built-in netconsole streams printk over the USB RNDIS link from initramfs
# onward, so a hard reset still leaves evidence on the host even when the
# journal never reaches the disk and ramoops stays empty. Dynamic config
# lets the initramfs bind it through configfs once usb0 has its address.
CONFIG_NETCONSOLE=y
CONFIG_NETCONSOLE_DYNAMIC=y
