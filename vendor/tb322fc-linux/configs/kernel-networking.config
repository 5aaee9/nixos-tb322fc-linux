# Built-in support for the pinned NixOS iptables-nft firewall.
# No matching module tree is shipped by the temporary USB/NBD image.
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# iptables-nft creates separate IPv4 and IPv6 filter/mangle tables.
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y

# Compatibility matches include TCP/UDP and ICMP/ICMPv6 in xt_tcpudp.
CONFIG_NETFILTER_XTABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y

# The generated ESTABLISHED,RELATED rule uses the xt conntrack match.
CONFIG_NF_CONNTRACK=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y

# rpfilter --validmark uses xt matches, not the native nft fib expression.
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_MATCH_RPFILTER=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_MATCH_RPFILTER=y
