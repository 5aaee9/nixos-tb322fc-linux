diff --git a/vendor/kshim/tests/mmu_test.c b/vendor/kshim/tests/mmu_test.c
index eef162c..2112f84 100644
--- a/vendor/kshim/tests/mmu_test.c
+++ b/vendor/kshim/tests/mmu_test.c
@@ -2,11 +2,50 @@
 #include <assert.h>
 #include <stdint.h>
 #include <stdio.h>
+#include <string.h>
 #include <kshim_mmu.h>
 #include <dt.h>
 __asm__(".pushsection .test_image,\"aw\",@progbits\n.balign 4096\n"
         ".global __image_start_address__\n__image_start_address__:\n.space 8192\n"
         ".global __image_end_address__\n__image_end_address__:\n.popsection\n");
+extern unsigned char __image_start_address__[], __image_end_address__[];
+static struct dt_range cleaned[16];
+static size_t clean_count;
+void kshim_mmu_test_clean_range(uint64_t base, uint64_t size)
+{
+    assert(clean_count < 16);
+    cleaned[clean_count++] = (struct dt_range){base, size};
+}
+
+static void test_early_handoff_cleanup(void)
+{
+    uint64_t tree[512];
+    assert(!fdt_create_empty_tree(tree, sizeof(tree)));
+    assert(!fdt_setprop_u32(tree, 0, "#address-cells", 2));
+    assert(!fdt_setprop_u32(tree, 0, "#size-cells", 2));
+    int memory = fdt_add_subnode(tree, 0, "memory@80000000");
+    assert(memory >= 0);
+    assert(!fdt_setprop_string(tree, memory, "device_type", "memory"));
+    fdt64_t reg[] = {cpu_to_fdt64(0x80000000), cpu_to_fdt64(0x40000000)};
+    assert(!fdt_setprop(tree, memory, "reg", reg, sizeof(reg)));
+    uint32_t branch = 0x14000000;
+    memcpy(__image_start_address__, &branch, sizeof(branch));
+    memcpy(__image_start_address__ + 56, "ARM\x64\0\0\0\0", 8);
+    kshim_mmu_early_config_t early = {
+        .fdt = tree, .payload_base = 0xa0000000, .payload_end = 0xa1000000,
+    };
+    assert(!kshim_mmu_configure_early(&early));
+    clean_count = 0;
+    assert(!kshim_mmu_prepare_handoff());
+    /* Do not sweep all declared RAM or the MMIO/framebuffer window. */
+    assert(clean_count == 2);
+    assert(cleaned[0].base == (uint64_t)(uintptr_t)tree);
+    assert(cleaned[0].size == sizeof(tree));
+    assert(cleaned[1].base == (uint64_t)(uintptr_t)__image_start_address__);
+    assert(cleaned[1].size ==
+           (uint64_t)(__image_end_address__ - __image_start_address__));
+    clean_count = 0;
+}
 static uint64_t entry(uint64_t a)
 {
     uint64_t *table=(void*)(uintptr_t)kshim_mmu_root_table(); assert(table);
@@ -19,6 +58,7 @@ static uint64_t entry(uint64_t a)
 }
