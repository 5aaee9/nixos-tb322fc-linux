+static bool reservations_survive_capture(const void *fdt)
+{
+    int parent = fdt_path_offset(fdt, "/reserved-memory");
+    if (parent == -FDT_ERR_NOTFOUND)
+        return true;
+    if (parent < 0)
+        return false;
+    int node;
+    fdt_for_each_subnode(node, fdt, parent) {
+        int size;
+        const void *reg = fdt_getprop(fdt, node, "reg", &size);
+        if (!reg && size != -FDT_ERR_NOTFOUND)
+            return false;
+        /* The upstream snapshot omits unavailable nodes, including parents. */
+        if (reg && size > 0 && !dt_available(fdt, node))
+            return false;
+    }
+    return node == -FDT_ERR_NOTFOUND;
+}
