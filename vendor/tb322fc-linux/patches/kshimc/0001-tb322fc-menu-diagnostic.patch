--- a/vendor/kshim/src/Kconfig
+++ b/vendor/kshim/src/Kconfig
@@ -13,6 +13,15 @@
       splash/UI status string under /chosen/kshim,diag and hand that copy
       to the stock kernel.  Android then exposes it through
       /proc/device-tree/chosen/kshim,diag.
+
+config KSHIM_DIAGNOSTIC_MENU_LIMIT_MS
+    int "Diagnostic menu deadline independent of key interaction"
+    range 0 120000
+    default 0
+    help
+      Return the validated default payload when this many milliseconds have
+      passed, even after navigation cancels the ordinary countdown. Zero
+      disables this diagnostic limit. This is not a hardware watchdog.
 
