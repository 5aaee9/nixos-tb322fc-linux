--- /dev/null
+++ b/vendor/kshim/tests/tb322fc_diagnostic_test.c
@@ -0,0 +1,62 @@
+/* Run the actual menu loops with scripted input and time, without hardware. */
+#define main unused_upstream_test_main
+#define KSHIM_TEST_MAX_STEPS 100000
+/* Model the hardware timer during the final busy-loop boot hint, too. */
+#define KSHIM_TEST_FRAME_TICK_MS 1
+#include "platform_menu_test.c"
+#undef main
+
+static void assert_bounded_default(void)
+{
+    assert(h.now >= CONFIG_KSHIM_DIAGNOSTIC_MENU_LIMIT_MS);
+    assert(h.now < CONFIG_KSHIM_DIAGNOSTIC_MENU_LIMIT_MS + 1000U);
+    assert(h.reset_calls == 0 && h.off_calls == 0 && h.reboot_calls == 0);
+}
+
+static size_t choose_diagnostic(void)
+{
+    size_t selected = SIZE_MAX;
+    assert(kshim_platform_select(boot_fdt(), h.names, 1, 0, 1000, &selected) == 0);
+    return selected;
+}
+
+int main(void)
+{
+    /* Interaction cancels the visible countdown, not the diagnostic deadline. */
+    setup(false, 1);
+    h.info_mode = true;
+    ui_at(5, -1, 1);
+    assert(choose_diagnostic() == 0);
+    assert(h.countdown_zero > 0);
+    assert_bounded_default();
+
+    /* A partially typed serial selection cannot keep the runtime resident. */
+    setup(true, 1);
+    char_at(5, '1');
+    assert(choose_diagnostic() == 0);
+    assert(h.char_next == 1);
+    assert_bounded_default();
+
+    /* The actual TB322FC settings page also retains the original deadline. */
+    static const kshim_menu_role_t roles[] = {KSHIM_MENU_ROLE_ANDROID};
+    static const enum device_board boards[] = {DEVICE_BOARD_TB322FC};
+    struct device_info info = fixture_info();
+    info.board = DEVICE_BOARD_TB322FC;
+    size_t selected = SIZE_MAX;
+    setup(false, 1);
+    h.info_mode = true;
+    ui_at(5, 1, 1); /* Android, Settings, read-only device info. */
+    int rc = kshim_platform_select_localized_settings(boot_fdt(), h.names,
+        NULL, roles, &info, boards, 1, 0, 1000, 0, &selected);
+    assert(selected == 0);
+    assert(rc == 0 && h.info_snap_count >= 2);
+    assert_bounded_default();
+
+    /* An unresolved default must never become an automatic payload. */
+    struct menu_selection menu = {.default_ok = 0, .diagnostic_start = 0};
+    h.now = CONFIG_KSHIM_DIAGNOSTIC_MENU_LIMIT_MS + 1U;
+    assert(!diagnostic_menu_expired(&menu));
+
+    puts("PASS: GUI cancellation, serial input, settings page and unsafe default");
+    return 0;
+}
