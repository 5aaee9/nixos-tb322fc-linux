Subject: [PATCH] Add an opt-in bounded TB322FC menu diagnostic

Keep ordinary behavior when the diagnostic limit is zero. Exercise real
menu loops with simulated time/input. Fix disabled charger compilation
and avoid macro expansion of LVGL configuration paths.

--- a/vendor/kshim/CMakeLists.txt
+++ b/vendor/kshim/CMakeLists.txt
@@ -220,8 +220,12 @@
 set(LV_CONF_BUILD_DISABLE_THORVG_INTERNAL ON CACHE BOOL "" FORCE)
 set(LV_CONF_BUILD_DISABLE_EXAMPLES ON CACHE BOOL "" FORCE)
 set(LV_CONF_BUILD_DISABLE_DEMOS ON CACHE BOOL "" FORCE)
-set(LV_CONF_PATH "${CMAKE_SOURCE_DIR}/src/include/lv_conf.h" CACHE FILEPATH "" FORCE)
+# LVGL stringifies this macro; an unquoted path component such as "linux"
+# can expand to a compiler predefined macro. Use the include directory.
+set(LV_CONF_PATH "" CACHE FILEPATH "" FORCE)
+set(LV_CONF_INCLUDE_SIMPLE ON CACHE BOOL "" FORCE)
 add_subdirectory(third_party/lvgl EXCLUDE_FROM_ALL)
+target_include_directories(lvgl SYSTEM PUBLIC "${CMAKE_SOURCE_DIR}/src/include")
 include(${CMAKE_SOURCE_DIR}/ports/lvgl/CMakeLists.txt)
