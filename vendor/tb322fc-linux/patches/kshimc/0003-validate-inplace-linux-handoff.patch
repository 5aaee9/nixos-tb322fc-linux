diff --git a/vendor/kshim/src/include/linux_inplace.h b/vendor/kshim/src/include/linux_inplace.h
new file mode 100644
index 0000000..b3f8d8e
--- /dev/null
+++ b/vendor/kshim/src/include/linux_inplace.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include <dt.h>
+#include <manifest.h>
+
+/* Narrow Android + no-copy, built-in-DT Linux + shim RAM-test contract.
+ * The caller has already parsed and bounded the manifest and Image header. */
+struct kshim_linux_inplace {
+    const MANIFEST_ENTRY *const *entries;
+    uint32_t count;
+    const void *image;
+    uint64_t packed_base, packed_size, payload_size, android_image_size;
+    struct dt_range runtime;
+    const void *fdt;
+};
+int kshim_linux_inplace_check(const struct kshim_linux_inplace *context);
