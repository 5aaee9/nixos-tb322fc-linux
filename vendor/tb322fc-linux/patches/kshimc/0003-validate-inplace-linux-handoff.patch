diff --git a/vendor/kshim/tests/linux_inplace_test.c b/vendor/kshim/tests/linux_inplace_test.c
new file mode 100644
index 0000000..c6d1158
--- /dev/null
+++ b/vendor/kshim/tests/linux_inplace_test.c
@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: MIT */
+#include <linux_inplace.h>
+#include <assert.h>
+#include <stdio.h>
+#include <string.h>
+
+static uint64_t tree[1024], snapshot[1024];
+static unsigned char header[64];
+static MANIFEST_ENTRY android, linux_entry, shim;
+static const MANIFEST_ENTRY *entries[] = {&android, &linux_entry, &shim};
+static struct kshim_linux_inplace context;
+
+static void put64(unsigned offset, uint64_t value)
+{
+    for (unsigned i = 0; i < 8; ++i)
+        header[offset + i] = (unsigned char)(value >> (8 * i));
+}
+
+static void reset(void)
+{
+    assert(!fdt_create_empty_tree(tree, sizeof(tree)));
+    assert(!fdt_setprop_u32(tree, 0, "#address-cells", 2));
+    assert(!fdt_setprop_u32(tree, 0, "#size-cells", 2));
+    int memory = fdt_add_subnode(tree, 0, "memory@80000000");
+    assert(memory >= 0);
+    assert(!fdt_setprop_string(tree, memory, "device_type", "memory"));
+    fdt64_t reg[] = {cpu_to_fdt64(0x80000000), cpu_to_fdt64(0x10000000)};
+    assert(!fdt_setprop(tree, memory, "reg", reg, sizeof(reg)));
+    memset(header, 0, sizeof(header));
+    memcpy(header + 56, "ARM\x64", 4);
+    put64(16, 0x20000);
+    put64(24, 0xa);
+    android = (MANIFEST_ENTRY){.size=0x10000, .type=1, .flags=5, .alignment=21};
+    shim = (MANIFEST_ENTRY){.offset=0x20000, .size=0x400000, .type=3, .flags=4, .alignment=2};
+    linux_entry = (MANIFEST_ENTRY){.offset=0x600000, .size=0x10000, .type=1, .flags=4,
+                                   .alignment=21};
+    context = (struct kshim_linux_inplace){
+        .entries=entries, .count=3, .image=header,
+        .packed_base=0x80000000, .payload_size=0x620000, .packed_size=0x620100,
+        .android_image_size=0x20000, .runtime={0x80020000, 0x400000}, .fdt=tree,
+    };
+}
+
+static void check(int expected)
+{
+    memcpy(snapshot, tree, sizeof(tree));
+    assert(kshim_linux_inplace_check(&context) == expected);
+    assert(!memcmp(snapshot, tree, sizeof(tree)));
+}
+
+int main(void)
+{
+    reset(); check(0);
+    context.packed_base = UINT64_MAX - 0x1000; check(-1);
+    reset(); linux_entry.flags |= MF_ENTRY_FLAG_COPY; check(-2);
+    reset(); linux_entry.flags |= MF_ENTRY_FLAG_HAS_DEVICE_TREE_BLOB; check(-2);
+    reset(); linux_entry.offset = context.payload_size; check(-2);
+    reset(); header[56] = 0; check(-3);
+    reset(); put64(16, 0); check(-3);
+    reset(); put64(8, 0x80000); check(-3);
+    reset(); put64(24, 0xb); check(-3);
+    reset(); context.packed_base += 4; check(-4);
+    reset(); linux_entry.offset = 0x200000; check(-4);
+    reset(); put64(16, 0x30000); check(-4); /* BSS reaches manifest. */
+    reset(); context.android_image_size = 0x30000; check(-4);
+    reset(); context.runtime.size++; check(-4);
+    reset();
+    context.packed_base = (uint64_t)(uintptr_t)tree & ~UINT64_C(0x1fffff);
+    context.runtime.base = context.packed_base + shim.offset;
+    check(-5); /* Original FDT lies inside downloaded image. */
+    reset(); context.fdt = NULL; check(-1);
+    reset();
+    int memory = fdt_path_offset(tree, "/memory@80000000");
+    fdt64_t reg[] = {cpu_to_fdt64(0x80000000), cpu_to_fdt64(0x610000)};
+    assert(!fdt_setprop(tree, memory, "reg", reg, sizeof(reg)));
+    check(-6); /* BSS extends outside declared RAM. */
+    reset();
+    assert(!fdt_add_mem_rsv(tree, 0x80610000, 0x1000));
+    check(-7);
+    reset();
+    int reserved = fdt_add_subnode(tree, 0, "reserved-memory");
+    assert(reserved >= 0);
+    assert(!fdt_setprop_u32(tree, reserved, "#address-cells", 2));
+    assert(!fdt_setprop_u32(tree, reserved, "#size-cells", 2));
+    assert(!fdt_setprop_empty(tree, reserved, "ranges"));
+    int node = fdt_add_subnode(tree, reserved, "firmware@80600000");
+    assert(node >= 0);
+    reg[0] = cpu_to_fdt64(0x80600000); reg[1] = cpu_to_fdt64(0x1000);
+    assert(!fdt_setprop(tree, node, "reg", reg, sizeof(reg)));
+    assert(!fdt_setprop_empty(tree, node, "no-map"));
+    check(-7);
+    puts("Linux physical placement, BSS, DT and firmware reservations passed");
+}
