@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: MIT */
+#include <linux_inplace.h>
+#include <string.h>
+
+static uint64_t le64(const void *data)
+{
+    const unsigned char *p = data;
+    uint64_t value = 0;
+    for (unsigned i = 0; i < 8; ++i)
+        value |= (uint64_t)p[i] << (8 * i);
+    return value;
+}
+
+static bool valid_range(struct dt_range range)
+{
+    return range.size && range.base <= UINT64_MAX - range.size;
+}
+
+static bool overlap(struct dt_range a, struct dt_range b)
+{
+    return a.base < b.base + b.size && b.base < a.base + a.size;
+}
+
+int kshim_linux_inplace_check(const struct kshim_linux_inplace *c)
+{
+    if (!c || !c->entries || c->count != 3 || !c->image || !c->fdt ||
+        !c->entries[0] || !c->entries[1] || !c->entries[2] ||
+        !c->payload_size || c->payload_size >= c->packed_size ||
+        c->packed_size > UINT64_C(0x8000000) ||
+        c->packed_base > UINT64_MAX - c->packed_size)
+        return -1;
+    const MANIFEST_ENTRY *android = c->entries[0], *target = c->entries[1];
+    const MANIFEST_ENTRY *shim = c->entries[2];
+    if (android->offset || android->type != MF_ENTRY_TYPE_LINUX ||
+        android->flags != (MF_ENTRY_FLAG_BASE_IMAGE | MF_ENTRY_FLAG_EXECUTABLE) ||
+        target->type != MF_ENTRY_TYPE_LINUX || target->flags != MF_ENTRY_FLAG_EXECUTABLE ||
+        target->entry_offset || target->load_address || target->copy_size_max ||
+        target->device_tree_blob_entry || target->alignment != 21 ||
+        shim->type != MF_ENTRY_TYPE_SHIM || shim->flags != MF_ENTRY_FLAG_EXECUTABLE)
+        return -2;
+    for (unsigned i = 0; i < c->count; ++i) {
+        const MANIFEST_ENTRY *e = c->entries[i];
+        if (!e->size || e->offset > c->payload_size ||
+            e->size > c->payload_size - e->offset)
+            return -2;
+    }
+    const unsigned char *header = c->image;
+    if (target->size < 64 || memcmp(header + 56, "ARM\x64", 4) ||
+        le64(header + 8) != 0 || le64(header + 24) != 0xa ||
+        le64(header + 16) < 64 || c->android_image_size < 64)
+        return -3;
+    struct dt_range ranges[] = {
+        {c->packed_base, c->android_image_size > android->size ?
+                        c->android_image_size : android->size},
+        {c->packed_base + target->offset, le64(header + 16) > target->size ?
+                                        le64(header + 16) : target->size},
+        {c->packed_base + shim->offset, shim->size},
+    };
+    if ((ranges[1].base & (UINT64_C(0x200000) - 1)) ||
+        !valid_range(c->runtime) ||
+        !dt_contains(ranges[2], c->runtime.base, c->runtime.size))
+        return -4;
+    struct dt_range payload = {c->packed_base, c->payload_size};
+    for (unsigned i = 0; i < 3; ++i) {
+        if (!valid_range(ranges[i]) ||
+            !dt_contains(payload, ranges[i].base, ranges[i].size))
+            return -4;
+        for (unsigned j = 0; j < i; ++j)
+            if (overlap(ranges[i], ranges[j]))
+                return -4;
+    }
+    uint64_t fdt_base = (uint64_t)(uintptr_t)c->fdt;
+    if ((fdt_base & 7) || fdt_check_header(c->fdt))
+        return -5;
+    struct dt_range fdt_range = {fdt_base, (uint32_t)fdt_totalsize(c->fdt)};
+    struct dt_range packed = {c->packed_base, c->packed_size};
+    if (!valid_range(fdt_range) || fdt_range.size > UINT64_C(0x200000) ||
+        dt_validate(c->fdt, fdt_range.size) || overlap(fdt_range, packed))
+        return -5;
+
+    bool in_ram = false;
+    int node;
+    fdt_for_each_subnode(node, c->fdt, 0) {
+        const char *type = dt_string(c->fdt, node, "device_type");
+        if (!type || strcmp(type, "memory") || !dt_available(c->fdt, node))
+            continue;
+        for (unsigned i = 0; ; ++i) {
+            struct dt_range bank;
+            if (dt_raw_reg(c->fdt, node, i, &bank.base, &bank.size))
+                break;
+            if (valid_range(bank) && dt_contains(bank, ranges[1].base, ranges[1].size))
+                in_ram = true;
+        }
+    }
+    if (!in_ram)
+        return -6;
+    struct dt_range reserved[128];
+    bool no_map[128];
+    size_t count = 0;
+    if (dt_reservations(c->fdt, reserved, no_map, 128, &count))
+        return -7;
+    for (size_t i = 0; i < count; ++i)
+        if (!valid_range(reserved[i]) || overlap(ranges[1], reserved[i]))
+            return -7;
+    return 0;
+}
