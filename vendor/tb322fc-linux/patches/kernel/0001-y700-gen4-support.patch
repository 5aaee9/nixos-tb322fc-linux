+static int aw8693x_haptic_init(struct aw86927_data *haptics)
+{
+	static const struct reg_sequence analog_init[] = {
+		{ 0x6f, 0x1c }, { 0x70, 0x0e }, { 0x72, 0x03 },
+		{ 0x77, 0x80 }, { 0x7d, 0x41 },
+	};
