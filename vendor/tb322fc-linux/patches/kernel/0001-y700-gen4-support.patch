+				 AW86938_PLAYCFG1_BST_VOUT_VREFSET_MASK,
+				 AW86938_PLAYCFG1_BST_7000MV);
+	if (err)
+		return err;
+
+	return regmap_update_bits(haptics->regmap, AW86927_PLAYCFG3_REG,
+				  AW8693X_PLAYCFG3_AUTO_BST_MASK, 0);
+}
