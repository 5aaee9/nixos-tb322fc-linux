+static int
+pwrseq_qcom_wcn_vote_index(struct pwrseq_qcom_wcn_ctx *ctx, const char *rail)
+{
+	size_t i;
+
+	for (i = 0; i < ctx->num_vreg_pdc_map; i++) {
+		if (!strcmp(ctx->vreg_pdc_map[i].from, rail))
+			return i;
+	}
