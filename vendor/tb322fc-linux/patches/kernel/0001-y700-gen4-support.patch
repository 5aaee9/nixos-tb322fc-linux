+	if (!num_params || num_params > ATH12K_QMI_WLFW_PMU_PARAMS_MAX_V01)
+		return -EINVAL;
+
+	params = kcalloc(num_params, sizeof(*params), GFP_KERNEL);
+	if (!params)
+		return -ENOMEM;
+
+	for (i = 0; i < num_params; i++) {
+		const struct qmi_wlanfw_pmu_param_v01 *src =
